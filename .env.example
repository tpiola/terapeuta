# URL pública final, sem barra no final
NEXT_PUBLIC_SITE_URL=https://terapeuta-next.vercel.app

# Cole apenas o token entregue pelo Google Search Console.
# Exemplo ilustrativo (não é uma verificação válida): google-site-verification-demo
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Opcional. Preencha somente quando o contêiner do Google Tag Manager existir.
# Formato esperado: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
